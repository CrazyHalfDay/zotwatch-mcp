# --- ZotWatch bot configuration ---------------------------------------------

# Path to the ZotWatch project on disk (the directory that holds
# config/config.yaml and the data/ artifacts). If unset, the bot searches the
# current directory and its parents for config/config.yaml.
ZOTWATCH_DIR=/path/to/AIZotWatch

# Where to cache the iLink bot token after the one-time QR login.
# Default: ~/.zotwatch_bot/ilink_token.json
# ILINK_TOKEN_FILE=/home/you/.zotwatch_bot/ilink_token.json

# Optional whitelist of WeChat user ids allowed to use the bot (comma-separated).
# Leave empty to allow anyone who can message the linked account.
# ILINK_ALLOWED_USERS=o9cq800kum_xxx@im.wechat

# Max papers per list (today / search), indexable by 收藏/总结.
# ZOTWATCH_BOT_LIST_LIMIT=8

# --- ZotWatch credentials (same as the main project) ------------------------
# These are read from the ZotWatch project's own .env; you usually do NOT need
# to duplicate them here. Listed for reference:
# ZOTERO_API_KEY=...
# ZOTERO_USER_ID=...
# VOYAGE_API_KEY=...           # or DASHSCOPE_API_KEY, per embedding.provider
# DEEPSEEK_API_KEY=...         # or MOONSHOT_API_KEY / OPENROUTER_API_KEY
